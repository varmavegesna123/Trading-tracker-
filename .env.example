# Frontend Environment Configuration (Vite + React)
# Set VITE_API_BASE_URL to your deployed Django backend URL on Vercel
VITE_API_BASE_URL=https://your-django-backend.vercel.app

# Optional direct endpoint override (if not using VITE_API_BASE_URL)
# VITE_DJANGO_DATA_URL=https://your-django-backend.vercel.app/api/data

# Supabase Auth & Cloud Database
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
