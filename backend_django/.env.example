# Django Backend Environment Configuration
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-random-secret-key-in-prod
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=.vercel.app,localhost,127.0.0.1

# Persistent Database (PostgreSQL required on Vercel)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Examples: Supabase Postgres, Neon Postgres, Vercel Postgres, Railway Postgres
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# CORS & CSRF (Include your frontend Vercel deployment URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-frontend.vercel.app

# Security & Reverse Proxy
DJANGO_SECURE_SSL_REDIRECT=True

# Optional: Supabase JWT Verification (if syncing with Supabase Auth)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard
